  "views": [
    {
      "name": "vw_total_products_by_category",
      "definition": "select `c`.`ID` AS `category_id`,`c`.`name` AS `category_name`,count(`pc`.`product_ID`) AS `total_products` from (`tbc_categories` `c` left join `tbd_products_categories` `pc` on(((`pc`.`category_ID` = `c`.`ID`) and (`pc`.`status` = 0x01)))) group by `c`.`ID`,`c`.`name`"
    },
    {
      "name": "vw_trazabilidad_categorias",
      "definition": "select `tb_logs`.`ID` AS `ID`,`tb_logs`.`table_name` AS `table_name`,`tb_logs`.`operation` AS `operation`,`tb_logs`.`db_user` AS `db_user`,`tb_logs`.`operation_description` AS `operation_description`,`tb_logs`.`operation_date` AS `operation_date`,`tb_logs`.`operation_status` AS `operation_status` from `tb_logs` where ((`tb_logs`.`table_name` = 'tbc_categories') and (`tb_logs`.`operation_status` = 0x01))"
    },
    {
      "name": "vw_trazabilidad_productos",
      "definition": "select `l`.`ID` AS `log_id`,`l`.`operation` AS `operation`,`l`.`db_user` AS `db_user`,`l`.`operation_description` AS `operation_description`,`l`.`operation_date` AS `operation_date`,`l`.`operation_status` AS `operation_status` from `tb_logs` `l` where (`l`.`table_name` = 'tb_products')"
    },
    {
      "name": "vw_trazabilidad_productos_categorias",
      "definition": "select `tb_logs`.`ID` AS `ID`,`tb_logs`.`table_name` AS `table_name`,`tb_logs`.`operation` AS `operation`,`tb_logs`.`db_user` AS `db_user`,`tb_logs`.`operation_description` AS `operation_description`,`tb_logs`.`operation_date` AS `operation_date`,`tb_logs`.`operation_status` AS `operation_status` from `tb_logs` where ((`tb_logs`.`table_name` = 'tbd_products_categories') and (`tb_logs`.`operation_status` = 0x01))"
    },
    {
      "name": "vw_trazabilidad_proveedores",
      "definition": "select `pup`.`product_ID` AS `producto_id`,`pup`.`user_ID` AS `usuario_id`,`pup`.`type_ownership` AS `tipo_propiedad`,`pup`.`status` AS `estado_proveedor`,`pup`.`available_date` AS `fecha_disponible`,`pup`.`creation_date` AS `fecha_creacion`,`pup`.`last_update` AS `ultima_actualizacion`,`l`.`ID` AS `log_id`,`l`.`table_name` AS `tabla_afectada`,`l`.`table_operation` AS `operacion_tabla`,`l`.`operation` AS `tipo_operacion`,`l`.`db_user` AS `usuario_bd`,`l`.`operation_description` AS `descripcion_log`,`l`.`operation_date` AS `fecha_evento`,`l`.`operation_status` AS `estado_log` from (`tbd_products_users_providers` `pup` left join `tb_logs` `l` on(((`l`.`table_name` = 'tbd_products_users_providers') and (`l`.`operation_description` like concat('%Producto ID: ',`pup`.`product_ID`,'%')) and (`l`.`operation_description` like concat('%Usuario ID: ',`pup`.`user_ID`,'%')))))"
    },
    {
      "name": "vw_trazabilidad_usuarios",
      "definition": "select `tb_logs`.`ID` AS `ID`,`tb_logs`.`table_name` AS `table_name`,`tb_logs`.`operation` AS `operation`,`tb_logs`.`db_user` AS `db_user`,`tb_logs`.`operation_description` AS `operation_description`,`tb_logs`.`operation_date` AS `operation_date`,`tb_logs`.`operation_status` AS `operation_status` from `tb_logs` where ((`tb_logs`.`table_name` = 'tb_users') and (`tb_logs`.`operation_status` = 0x01))"
    }
